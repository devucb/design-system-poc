{
  "$schema": "./.vscode/tsconfig.schema.json",
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@ds/theme": ["packages/theme/src/index.ts"],
      "@ds/theme/*": ["packages/theme/src/*"],
      "@ds/ui": ["packages/ui/src/index.ts"],
      "@ds/ui/*": ["packages/ui/src/*"],
      "@ds/controller": ["packages/controller/src/index.ts"],
      "@ds/controller/*": ["packages/controller/src/*"],
      "@ds/network": ["packages/network/src/index.ts"],
      "@ds/network/*": ["packages/network/src/*"],
      "@ds/language": ["packages/language/src/index.ts"],
      "@ds/language/*": ["packages/language/src/*"],
      "@ds/navigation": ["packages/navigation/src/index.ts"],
      "@ds/navigation/*": ["packages/navigation/src/*"],
      "@ds/store": ["packages/store/src/index.ts"],
      "@ds/store/*": ["packages/store/src/*"],
      "@ds/storage": ["packages/storage/src/index.ts"],
      "@ds/storage/*": ["packages/storage/src/*"],
      "@ds/native": ["packages/native/src/index.ts"],
      "@ds/native/*": ["packages/native/src/*"],
      "@ds/telemetry": ["packages/telemetry/src/index.ts"],
      "@ds/telemetry/*": ["packages/telemetry/src/*"],
      "@ds/views": ["packages/views/src/index.ts"],
      "@ds/views/*": ["packages/views/src/*"]
    }
  }
}
