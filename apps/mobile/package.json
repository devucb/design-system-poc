{
  "name": "mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "ENVFILE=.env.production react-native run-android --mode prodDebug",
    "android:dev": "ENVFILE=.env.development react-native run-android --mode devDebug",
    "android:staging": "ENVFILE=.env.staging react-native run-android --mode stagingDebug",
    "ios": "ENVFILE=.env.production react-native run-ios --scheme DesignSystem-prod --simulator \"iPhone 17\"",
    "ios:dev": "ENVFILE=.env.development react-native run-ios --scheme DesignSystem-dev --simulator \"iPhone 17\"",
    "ios:staging": "ENVFILE=.env.staging react-native run-ios --scheme DesignSystem-staging --simulator \"iPhone 17\"",
    "start": "react-native start",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "e2e:ios": "detox test --configuration ios.sim.debug",
    "e2e:ios:build": "ENVFILE=.env.development detox build --configuration ios.sim.debug",
    "e2e:android": "detox test --configuration android.emu.debug",
    "e2e:android:build": "ENVFILE=.env.development detox build --configuration android.emu.debug"
  },
  "dependencies": {
    "@apollo/client": "4.3.1",
    "@ds/controller": "*",
