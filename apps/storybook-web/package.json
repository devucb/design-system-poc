{
  "name": "ds-storybook-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "name": "storybook-web"
  },
  "scripts": {
    "serve": "storybook dev -p 6006 --no-open",
    "build": "storybook build",
    "test": "vitest --project=storybook --run",
    "test-storybook": "vitest --project=storybook",
    "test:coverage": "vitest --project=storybook --coverage --run",
    "chromatic": "chromatic --build-script-name build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ds/controller": "*",
    "@ds/language": "*",
    "@ds/native": "*",
    "@ds/storage": "*",
    "@ds/theme": "*",
    "@ds/ui": "*",
    "@shopify/flash-list": "2.3.2",
    "i18next": "26.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.0.12",
    "react-native-gesture-handler": "2.32.0",
    "react-native-safe-area-context": "5.5.2",
    "react-native-svg": "15.15.5",
    "react-native-web": "0.21.1",
    "recharts": "3.10.1",
    "tamagui": "1.144.4",
    "yup": "1.7.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.3.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-themes": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tamagui/vite-plugin": "1.144.4",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/browser-playwright": "4.1.6",
    "@vitest/coverage-v8": "4.1.6",
    "playwright": "1.56.1",
    "storybook": "10.6.0",
    "typescript": "5.8.3",
    "vite": "7.1.5",
    "vitest": "4.1.6"
  }
}
