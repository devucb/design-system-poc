{
  "$schema": "../../.vscode/tsconfig.schema.json",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client", "vitest/globals"],
    "lib": ["ESNext", "DOM"],
    "baseUrl": ".",
    "moduleSuffixes": [".web", ""],
    "paths": {
      "@ds/ui": ["../../packages/ui/src/index.ts"],
      "@ds/ui/*": ["../../packages/ui/src/*"],
      "@ds/controller": ["../../packages/controller/src/index.ts"],
      "@ds/controller/*": ["../../packages/controller/src/*"],
      "@ds/theme": ["../../packages/theme/src/index.ts"],
      "@ds/theme/*": ["../../packages/theme/src/*"],
      "@ds/language": ["../../packages/language/src/index.ts"],
      "@ds/language/*": ["../../packages/language/src/*"],
      "@ds/storage": ["../../packages/storage/src/index.ts"],
      "@ds/storage/*": ["../../packages/storage/src/*"],
      "@ds/native": ["../../packages/native/src/index.ts"],
      "@ds/native/*": ["../../packages/native/src/*"]
    }
  },
  "include": [
    ".storybook",
    "src",
    "types",
    "vitest.config.ts",
    "vite.config.ts",
    "../../packages/ui/src/**/*.ts",
    "../../packages/ui/src/**/*.tsx",
    "../../packages/controller/src/**/*.ts",
    "../../packages/controller/src/**/*.tsx",
    "../storybook/src/forms/**/*.ts",
    "../storybook/src/forms/**/*.tsx",
    "../../packages/theme/src/**/*.ts",
    "../../packages/theme/src/**/*.tsx",
    "../../packages/language/src/**/*.ts",
    "../../packages/language/src/**/*.tsx",
    "../../packages/storage/src/**/*.ts",
    "../../packages/native/src/**/*.ts"
  ],
  "exclude": [
    "../../packages/ui/src/**/*.test.ts",
    "../../packages/ui/src/**/*.test.tsx",
    "../../packages/ui/src/Sheet/Sheet.tsx",
    "../../packages/ui/src/List/sheetScroll.ts",
    "../../packages/ui/src/Graph/BarGraph/BarGraph.tsx",
    "../../packages/ui/src/Graph/LineGraph/LineGraph.tsx",
    "../../packages/ui/src/SliderCarousel/SliderCarousel.tsx",
    "../../packages/ui/src/inputs/DateTimePicker/DateTimePicker.tsx",
    "../../packages/native/src/haptics.ts",
    "../../packages/native/src/NativeHaptics.ts",
    "../../packages/native/src/**/*.test.ts"
  ]
}
