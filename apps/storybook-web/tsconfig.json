{
  "$schema": "../../.vscode/tsconfig.schema.json",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client", "vitest/globals"],
    "lib": ["ESNext", "DOM"],
    "baseUrl": ".",
    "moduleSuffixes": [".web", ""],
    "paths": {
      "@ds/ui/*": ["../../packages/ui/src/*"],
      "@ds/theme/*": ["../../packages/theme/src/*"],
      "@ds/i18n/*": ["../../packages/i18n/src/*"],
      "@ds/storage/*": ["../../packages/storage/src/*"]
    }
  },
  "include": [
    ".storybook",
    "src",
    "types",
    "vitest.config.ts",
    "vite.config.ts",
    "../../packages/ui/src/**/*.ts",
    "../../packages/ui/src/**/*.tsx",
    "../../packages/theme/src/**/*.ts",
    "../../packages/theme/src/**/*.tsx",
    "../../packages/i18n/src/**/*.ts",
    "../../packages/i18n/src/**/*.tsx",
    "../../packages/storage/src/**/*.ts"
  ],
  "exclude": [
    "../../packages/ui/src/**/*.test.ts",
    "../../packages/ui/src/**/*.test.tsx"
  ]
}
