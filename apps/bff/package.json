{
  "name": "bff",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc",
    "serve": "tsc-watch --onSuccess \"node --env-file=../../.env.prod dist/main.js\"",
    "serve:dev": "tsc-watch --onSuccess \"node --env-file=../../.env.dev dist/main.js\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/server": "5.4.0",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "13.2.1",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/graphql": "13.2.0",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.1.6",
    "graphql": "16.11.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "tsc-watch": "6.3.1",
    "typescript": "5.8.3"
  }
}
