{
  "name": "@ds/source",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "android": "nx run native:android",
    "android:dev": "nx run native:android:dev",
    "android:uat": "nx run native:android:uat",
    "android:prod": "nx run native:android:prod",
    "ios": "nx run native:ios",
    "ios:dev": "nx run native:ios:dev",
    "ios:uat": "nx run native:ios:uat",
    "ios:prod": "nx run native:ios:prod",
    "start": "nx run native:start",
    "start:dev": "nx run native:start:dev",
    "start:uat": "nx run native:start:uat",
    "start:prod": "nx run native:start:prod",
    "web": "nx run web:serve",
    "lint": "nx run-many -t lint",
    "test": "nx run native:test",
    "test:update": "nx run native:test -- -u",
    "test:storybook": "nx run storybook-web:test",
    "test:storybook:coverage": "nx run storybook-web:test:coverage",
    "chromatic": "nx run storybook-web:chromatic",
    "typecheck": "nx run-many -t typecheck",
    "storybook": "nx run storybook:start",
    "storybook:ios": "nx run storybook:ios",
    "storybook:android": "nx run storybook:android",
    "storybook:web": "nx run storybook-web:serve"
  },
  "devDependencies": {
    "@nx/js": "22.1.1",
    "@nx/react": "22.1.1",
    "@nx/vite": "22.1.1",
    "nx": "22.1.1",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.4",
    "react-native-gesture-handler": "2.32.0",
    "tamagui": "1.144.4",
    "zustand": "5.0.15",
    "@sentry/core": "10.71.0",
    "@sentry/browser": "10.71.0",
    "@sentry/react": "10.71.0"
  }
}
