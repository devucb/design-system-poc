{
  "name": "@ds/source",
  "version": "1.0.5",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "android": "nx run mobile:android",
    "android:dev": "nx run mobile:android:dev",
    "android:staging": "nx run mobile:android:staging",
    "ios": "nx run mobile:ios",
    "ios:dev": "nx run mobile:ios:dev",
    "ios:staging": "nx run mobile:ios:staging",
    "start": "nx run mobile:start",
    "web": "nx run web:serve",
    "web:dev": "nx run web:serve:dev",
    "bff": "nx run bff:serve",
    "bff:dev": "nx run bff:serve:dev",
    "codegen": "nx run network:codegen",
    "lint": "nx run-many -t lint",
    "test": "nx run mobile:test",
    "test:update": "nx run mobile:test -- -u",
    "test:storybook": "nx run storybook-web:test",
    "test:storybook:coverage": "nx run storybook-web:test:coverage",
    "chromatic": "nx run storybook-web:chromatic",
    "typecheck": "nx run-many -t typecheck",
    "storybook": "nx run storybook:start",
    "storybook:ios": "nx run storybook:ios",
    "storybook:android": "nx run storybook:android",
    "storybook:web": "nx run storybook-web:serve",
    "e2e:ios": "nx run storybook:e2e:ios",
    "e2e:ios:build": "nx run storybook:e2e:ios:build",
    "e2e:mobile:ios": "nx run mobile:e2e:ios",
    "e2e:mobile:ios:build": "nx run mobile:e2e:ios:build",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@nx/js": "22.1.1",
    "@nx/react": "22.1.1",
    "@nx/vite": "22.1.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "husky": "9.1.7",
    "nx": "22.1.1",
    "semantic-release": "25.0.9",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.4",
    "react-native-gesture-handler": "2.32.0",
    "tamagui": "1.144.4",
    "zustand": "5.0.15",
    "@sentry/core": "10.71.0",
    "@sentry/browser": "10.71.0",
    "@sentry/react": "10.71.0",
    "conventional-changelog-writer": "9.2.1"
  }
}
