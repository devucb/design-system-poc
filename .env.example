# Public values only. No secrets belong in this file or in any .env file.
# Auth tokens, keystore passwords, JWT_SECRET, and CHROMATIC_PROJECT_TOKEN
# come from the process environment or GitHub Actions secrets.
#
# Mobile deploy reads apps/mobile/.env.development | .env.staging | .env.production
# (react-native-config, selected with ENVFILE). Copy apps/mobile/.env.example.
# Web and BFF are not part of the mobile deploy. Their local templates stay here:
#   cp .env.dev.example .env.dev
#   cp .env.prod.example .env.prod
#
# Seeded user: demo@example.com / demo
# Android emulator GraphQL: http://10.0.2.2:4000/graphql

GRAPHQL_URL=http://localhost:4000/graphql
VITE_GRAPHQL_URL=http://localhost:4000/graphql
BFF_PORT=4000

SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1
SENTRY_ORG=
SENTRY_PROJECT=
