# Copy flavor files at the repo root, then fill values:
#   cp .env.dev.example .env.dev
#   cp .env.uat.example .env.uat
#   cp .env.prod.example .env.prod
# Leave a value empty to skip that piece.

# Native Metro loads `.env.${APP_ENV}` (dev | uat | prod), then `.env` as fallback.
# Restart Metro after changing. Scripts set APP_ENV (npm run ios:dev / android:uat / …).

# Web SDK (Vite client). Restart `npm run web` after changing this.
VITE_SENTRY_DSN=

# Web source maps / releases (`@sentry/vite-plugin`, used on `vite build`).
# Org slug: devucb. Web project slug: design-system-web. Mobile: devucb-mobile.
# Auth token from Settings → Auth Tokens (Project: Read & Write, Release: Admin).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Chromatic CLI (optional; the Visual Tests panel uses OAuth).
# GitHub Actions uses repo secret CHROMATIC_PROJECT_TOKEN — do not commit it.
CHROMATIC_PROJECT_TOKEN=
