#!/bin/sh
# Scans staged changes. Enable with: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed." >&2
  echo "Install it (brew install gitleaks), then: git config core.hooksPath .githooks" >&2
  exit 1
fi

gitleaks protect --staged --redact --no-banner
